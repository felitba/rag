
{
  "project": {
    "name": "fashion-rag",
    "environment": "development",
    "log_level": "DEBUG",
    "log_file": "logs/fashion_rag.log"
  },
  "store": {
    "name": "Polyvore",
    "url": "https://huggingface.co/datasets/mvasil/polyvore-outfits",
    "about": "Outfits armados por la comunidad de Polyvore, un sitio de moda que cerró en 2018. Usamos una muestra del dataset público Polyvore Outfits."
  },
  "dataset": {
    "huggingface_id": "mvasil/polyvore-outfits",
    "configuration": "nondisjoint",
    "split": "train",
    "local_data_dir": "data",
    "images_dir": "data/images",
    "items_file": "data/catalog_items.jsonl",
    "outfits_file": "data/outfits.json"
  },
  "embeddings": {
    "provider": "clip",
    "model_name": "ViT-B/32",
    "device": "auto",
    "normalize_embeddings": true,
    "batch_size": 32
  },
  "image_preprocessing": {
    "enabled": true,
    "model_name": "u2net",
    "max_side": 1024,
    "background_color": "#f1f0ec",
    "padding_ratio": 0.10
  },
  "vector_store": {
    "provider": "chroma",
    "persist_directory": "chroma_db",
    "collection_name": "fashion_items",
    "distance_metric": "cosine",
    "top_k": 30
  },
  "category_classifier": {
    "enabled": true,
    "model_name": "patrickjohncyh/fashion-clip",
    "minimum_margin": 0.015
  },
  "hybrid_reranker": {
    "weights": {
      "cosine_similarity": 0.5,
      "color": 0.25,
      "category": 0.25
    },
    "color_similarity": {
      "delta_e_scale": 40.0,
      "tone_weight": 0.75,
      "coverage_weight": 0.25
    }
  },
  "context_precision": {
    "color_similarity_threshold": 0.5
  },
  "monitoring": {
    "enabled": true,
    "database_path": "storage/monitoring.sqlite3",
    "retention_days": 30
  },
  "retrieval": {
    "max_outfits": 5,
    "deduplicate_outfits": true,
    "exclude_query_item": true,
    "minimum_similarity": null
  },
    "query_rewriting": {
    "enabled": true,
    "max_queries": 4,
    "mode": "auto",
    "category_filter": true,
    "photo_weight": 0.5,
    "text_weight": 0.5
  },
  "generator": {
    "enabled": true,
    "model": "gpt-4.1-mini",
    "base_url": "https://sa-llmproxy.it.itba.edu.ar/",
    "fallbacks": {
      "huggingface": {
        "enabled": false,
        "api_key_env": "HF_TOKEN",
        "model_env": "HF_MODEL",
        "model": "Qwen/Qwen3-32B",
        "base_url": "https://router.huggingface.co/v1",
        "input_usd_per_million_tokens": 0.0,
        "cached_input_usd_per_million_tokens": 0.0,
        "output_usd_per_million_tokens": 0.0
      },
      "openrouter": {
        "enabled": true,
        "api_key_env": "OPENROUTER_API_KEY",
        "model_env": "OPENROUTER_MODEL",
        "model": "openrouter/free",
        "base_url": "https://openrouter.ai/api/v1",
        "json_object_mode": true,
        "require_parameters": true,
        "reasoning_effort": "none",
        "max_completion_tokens": 2800,
        "input_usd_per_million_tokens": 0.0,
        "cached_input_usd_per_million_tokens": 0.0,
        "output_usd_per_million_tokens": 0.0
      }
    },
    "top_n_outfits": 10,
    "max_generated_outfits": 3,
    "extra_drafts": 2,
    "timeout_seconds": 25,
    "use_images": false,
    "max_images": 60,
    "input_usd_per_million_tokens": 0.4,
    "cached_input_usd_per_million_tokens": 0.1,
    "output_usd_per_million_tokens": 1.6
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": true
  }
}
