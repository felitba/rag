
{
  "project": {
    "name": "fashion-rag",
    "environment": "development",
    "log_level": "DEBUG",
    "log_file": "logs/fashion_rag.log"
  },
  "dataset": {
    "huggingface_id": "mvasil/polyvore-outfits",
    "configuration": "nondisjoint",
    "split": "train",
    "local_data_dir": "data",
    "images_dir": "data/images",
    "items_file": "data/catalog_items.jsonl",
    "outfits_file": "data/outfits.json"
  },
  "embeddings": {
    "provider": "clip",
    "model_name": "ViT-B/32",
    "device": "auto",
    "normalize_embeddings": true,
    "batch_size": 32
  },
  "vector_store": {
    "provider": "chroma",
    "persist_directory": "chroma_db",
    "collection_name": "fashion_items",
    "distance_metric": "cosine",
    "top_k": 30
  },
  "category_classifier": {
    "enabled": true,
    "model_name": "patrickjohncyh/fashion-clip"
  },
  "hybrid_reranker": {
    "weights": {
      "cosine_similarity": 0.5,
      "color": 0.25,
      "category": 0.25
    }
  },
  "retrieval": {
    "max_outfits": 5,
    "deduplicate_outfits": true,
    "exclude_query_item": true,
    "minimum_similarity": null
  },
  "generator": {
    "enabled": true,
    "model": "gpt-4.1-mini",
    "base_url": "https://sa-llmproxy.it.itba.edu.ar/",
    "top_n_outfits": 10,
    "max_generated_outfits": 3,
    "timeout_seconds": 25,
    "input_usd_per_million_tokens": 0.4,
    "cached_input_usd_per_million_tokens": 0.1,
    "output_usd_per_million_tokens": 1.6
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": true
  }
}
