# Backend LLM credentials. Generation falls back to retrieved outfits if no
# configured provider has credentials.
LLM_API_KEY=replace_me
# Optional direct OpenAI credentials instead of the configured proxy:
# OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://sa-llmproxy.it.itba.edu.ar/

# Optional provider fallbacks (must also be enabled in home_made_rag/config.json).
# OPENROUTER_API_KEY=replace_me
# OPENROUTER_MODEL=openrouter/free
# HF_TOKEN=replace_me
# HF_MODEL=Qwen/Qwen3-32B
