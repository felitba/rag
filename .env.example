# Copy this file to .env and set your key.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini

# Local storage. Relative paths are resolved from the project root.
CHROMA_PATH=storage/chroma
COLLECTION_NAME=fashion_garments
CLIP_MODEL=ViT-B/32

# Retrieval settings
TOP_K_GARMENTS=30
MAX_OUTFITS=5
MAX_IMAGES_PER_OUTFIT_FOR_LLM=2
MAX_UPLOAD_MB=10
